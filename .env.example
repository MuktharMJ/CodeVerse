# Optional server-only GitHub token for higher API rate limits.
# Never use a NEXT_PUBLIC_ prefix or commit a real token.
GITHUB_TOKEN=

# Optional server-side PostgreSQL connection. Blank keeps the local catalog fallback.
# Set credentials through your environment; never use NEXT_PUBLIC_DATABASE_URL.
DATABASE_URL=

# Opt-in database tests only. Use a disposable database, never production.
# npx tsx --test tests/database.spec.ts creates and drops only a random test schema.
TEST_DATABASE_URL=
